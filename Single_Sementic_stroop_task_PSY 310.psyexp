  <Flow>
    <Routine name="participant_instructions"/>
    <LoopInitiator loopType="TrialHandler" name="practiceloop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('word', 'SKY'), ('inkColor', 'red'), ('correctKey', 'r'), ('condition', 'incongruent'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'GRASS'), ('inkColor', 'green'), ('correctKey', 'g'), ('condition', 'congruent'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'CHAIR'), ('inkColor', 'red'), ('correctKey', 'r'), ('condition', 'control'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'WINDOW'), ('inkColor', 'green'), ('correctKey', 'g'), ('condition', 'control'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'PENCIL'), ('inkColor', 'yellow'), ('correctKey', 'y'), ('condition', 'control'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'TABLE'), ('inkColor', 'blue'), ('correctKey', 'b'), ('condition', 'control'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'LEMON'), ('inkColor', 'yellow'), ('correctKey', 'y'), ('condition', 'congruent'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'CHERRY'), ('inkColor', 'red'), ('correctKey', 'r'), ('condition', 'congruent'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'CHERRY'), ('inkColor', 'yellow'), ('correctKey', 'y'), ('condition', 'incongruent'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'SKY'), ('inkColor', 'blue'), ('correctKey', 'b'), ('condition', 'congruent'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'LEMON'), ('inkColor', 'green'), ('correctKey', 'g'), ('condition', 'incongruent'), ('fixationSec', np.float64(0.5))]), OrderedDict([('word', 'GRASS'), ('inkColor', 'blue'), ('correctKey', 'b'), ('condition', 'incongruent'), ('fixationSec', np.float64(0.5))])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="semantic_stroop_practice_12_RGBY.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="practiceloop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Practice_trial"/>
    <Routine name="Practice_isi"/>
    <LoopTerminator name="practiceloop"/>
